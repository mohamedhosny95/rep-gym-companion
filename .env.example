# Copy this file to .env for local reference only. The Worker itself reads
# these from Cloudflare's dashboard (Settings -> Variables and secrets) or via
# `wrangler secret put <NAME>`, never from a committed .env file.

# --- Required for Notion workout sync ---
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
REP_SYNC_KEY=

# --- Required for AI food analysis ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional: override the default health-log data sources ---
# NOTION_RECOVERY_DATA_SOURCE_ID=
# NOTION_NUTRITION_DATA_SOURCE_ID=
# NOTION_HYGIENE_DATA_SOURCE_ID=
# NOTION_FOOD_DATA_SOURCE_ID=

# --- Required for push notification reminders (see README "Push notifications") ---
# Also requires a PUSH_KV KV namespace binding in wrangler.jsonc.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY_JWK=
# VAPID_SUBJECT=mailto:you@example.com
