{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "rep-gym-companion",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING_COORDINATOR", "class_name": "PairingCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1-pairing-coordinator", "new_sqlite_classes": ["PairingCoordinator"] }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    { "binding": "PUSH_KV", "id": "3bea037a1d7b43de9b9994f43a48d843" }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PAIR_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
